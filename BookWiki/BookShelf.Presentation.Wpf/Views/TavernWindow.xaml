<Window x:Class="BookShelf.Presentation.Wpf.Views.TavernWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookShelf.Presentation.Wpf.Views"
        mc:Ignorable="d"
        Title="Таверна" Height="450" Width="400" Topmost="True" ShowInTaskbar="True"
        BorderThickness="0"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        >
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" 
                      CornerRadius="0" 
                      CaptionHeight="0" 
                      ResizeBorderThickness="5" />
        <!-- Оставляем 5 пикселей по краям для ресайза мышкой -->
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#EEEEEE"
            BorderThickness="1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Строка для хедера -->
                <RowDefinition Height="*"/>
                <!-- Строка для самого чата -->
            </Grid.RowDefinitions>

            <!-- ХЕДЕР ОКНА: Навешиваем MouseDown прямо сюда для перетаскивания всего окна -->
            <Border Grid.Row="0" 
            x:Name="HeaderBorder"
            Background="#FFFFFF"
            MouseDown="Border_MouseDown">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Для Тайтла -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Для кнопки Свернуть -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Для кнопки Закрыть -->
                    </Grid.ColumnDefinitions>

                    <!-- ТАЙТЛ / НАЗВАНИЕ -->
                    <TextBlock Grid.Column="0" 
                   Text="Таверна" 
                   Foreground="#333333" 
                   FontFamily="Segoe UI" 
                   FontWeight="SemiBold"
                   FontSize="12" 
                   Margin="10, 0, 0, 0"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
                    <!-- Чтобы текст не мешал кликать и перетаскивать -->

                    <!-- КНОПКА: СВЕРНУТЬ -->
                    <Button Grid.Column="1" 
                Width="28" Height="20"
                Background="Transparent" 
                BorderThickness="0"
                Margin="0,0,2,0"
                Click="MinimizeButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <Path Data="M 0,5 L 10,5" Stroke="#A2A2A2" StrokeThickness="1" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3F3F46"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- КНОПКА: ЗАКРЫТЬ (КРЕСТИК) -->
                    <Button Grid.Column="2" 
                Width="28" Height="20"
                Background="Transparent" 
                BorderThickness="0"
                Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <!-- Геометрия крестика -->
                                                <Path Data="M 0,0 L 8,8 M 0,8 L 8,0" Stroke="#A2A2A2" StrokeThickness="1" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <!-- Классический красный бэкграунд при наведении на крестик -->
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ТУТ БУДЕТ ЖИТЬ ТВОЙ ЧАТ -->
            <Grid Grid.Row="1" Background="#FFFFFF">
                <!-- Место для ObservableCollection сообщений -->
            </Grid>
        </Grid>
    </Border>
</Window>
